<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-11</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AcceptAllTests/AcceptAllTests.cs" />
    <Content Include="AcceptAllTests/AcceptAllTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.84.0" />
    <PackageReference Include="Verify.TUnit" Version="33.4.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleDI\CircleDI.csproj" />
    <ProjectReference Include="..\CircleDI.Blazor\CircleDI.Blazor.csproj" />
    <ProjectReference Include="..\CircleDI.MinimalAPI\CircleDI.MinimalAPI.csproj" />
  </ItemGroup>

</Project>
